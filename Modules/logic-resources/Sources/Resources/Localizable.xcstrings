    "eid_setup.pin_blocked.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele falsche Eingaben haben sie endgültig blockiert. Um fortzufahren, besuche ein Bürgeramt. Dort kannst du direkt eine Karten-PIN festlegen. Danach kannst du deinen Ausweiskarte zur App hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important: Your card PIN is blocked. Once you have successfully entered the PUK from your PIN letter, you can try entering the card PIN again."
          }
        }
      }
    },
