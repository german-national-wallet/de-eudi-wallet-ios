    "pid_presentation.sheet_explain_data.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wallet sendet immer nur den Teil deiner Daten, der wirklich für den Service benötigt wird. So verhindert die Wallet das unnötig viele Daten von dir preisgegeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wallet only ever sends the part of your data that is actually needed for the service. This prevents the wallet from revealing unnecessary amounts of your data."
          }
        }
      }
    },
    "pid_presentation.sheet_explain_data.title" : {
      "extractionState" : "manual",
