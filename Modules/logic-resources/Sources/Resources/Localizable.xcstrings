    "app_onboarding.invalid_bootloader_state.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bootloader deines Geräts ist entsperrt. Dadurch gilt das Gerät als unsicher und die App kann nicht genutzt werden. Die App wurde zurückgesetzt und alle Daten gelöscht. Installiere ein offizielles ROM und schließe den Bootloader, um die App wieder nutzen zu können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device's bootloader is unlocked, which makes the device unsafe and means the app can't be used. The app has been reset and all data has been deleted. Please install an official ROM and lock the bootloader to use the app again."
          }
        }
      }
    },
