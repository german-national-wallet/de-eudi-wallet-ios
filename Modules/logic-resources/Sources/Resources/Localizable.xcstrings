    "pid_issuance.onboarding_cards.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Die Wallet nutzt die Online-Ausweisfunktion deiner Ausweiskarte. Du kannst entweder den Personalausweis oder Aufenthaltstitel verwenden, um den Digitalen Ausweis zu erstellen. "
          }
        },
        "en" : {
          "stringUnit" : {
