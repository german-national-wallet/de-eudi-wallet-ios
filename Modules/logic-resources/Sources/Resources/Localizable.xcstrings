    },
    "pid_issuance.can_success.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Du kannst nun ein letztes Mal deine Karten-PIN eingeben. Sollte diese erneut nicht korrekt sein, wird die Karten-PIN gesperrt. Falls du die 6-stellige Karten-PIN noch nicht festgelegt hast, kannst du dies mit Hilfe der 5-stelligen Transport-PIN aus dem PIN-Brief oder vor Ort im Bürgeramt tun."
          }
        },
        "en" : {
