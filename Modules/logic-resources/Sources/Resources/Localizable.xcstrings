    "pid_issuance.no_card_available_info.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Digitalen Ausweis kannst du nur mit einem Personalausweis oder einem Aufenthaltstitel erstellen. Ausweisdokumente wie Reisepässe können nicht verwendet werden. Beantrage eine geeignete Ausweiskarte im Bürgeramt in deiner Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Digital ID can only be created using a national identity card or a residence permit.  Travel documents such as passports cannot be used.  Apply for a suitable ID at your citizen's office."
          }
        }
      }
    },
