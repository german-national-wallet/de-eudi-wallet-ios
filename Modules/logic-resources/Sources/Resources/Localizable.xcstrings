    "pid_issuance.eid_function_info.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist die Online-Ausweisfunktion? Sie ist die digitale Identitätsfunktion deiner Ausweiskarte — damit weist du dich sicher im Internet oder an Automaten aus und erstellst deinen Digitalen Ausweis in dieser Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is the online ID function? It's the digital identity feature on your ID card — use it to verify yourself securely online or at kiosks, and to create your digital ID in this wallet."
          }
        }
      }
    },
    "pid_issuance.eid_function_info.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN einrichten Um die Online-Ausweisfunktion zu nutzen, brauchst du eine persönliche 6-stellige Karten-PIN. Richte sie mit der 5-stelligen Transport-PIN aus deinem PIN-Brief ein, oder direkt im Bürgeramt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up your PIN To use the online ID function, you'll need a personal 6-digit card PIN. Set it up with the 5-digit transport PIN from your PIN letter, or directly at the citizens' office."
          }
        }
      }
    },
    "pid_issuance.eid_function_info.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Online-Ausweisfunktion deiner Ausweiskarte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The eID function of your ID card"
          }
        }
      }
    },
