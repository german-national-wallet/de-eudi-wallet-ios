    "pid_issuance.onboarding_eid.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Um die Online-Ausweisfunktion deiner Ausweiskarte nutzen zu können, musst du deine persönliche 6-stellige Karten-PIN festgelegt haben. Dies kann man mit Hilfe der 5-stelligen Transport-PIN aus dem PIN-Brief oder vor Ort im Bürgeramt tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important: To use the eID function of your ID card, you must have set your personal 6-digit eID PIN. You can do this using the 5-digit transport PIN from the PIN letter or directly at your local citizen’s office."
          }
        }
      }
    },
