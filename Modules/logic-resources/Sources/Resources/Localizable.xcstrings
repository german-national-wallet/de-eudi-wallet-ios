    "pid_issuance.sheet_explain_data.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erfassten Daten aus deinem Digitalen Ausweis unterscheiden sich von den Daten aus deiner Ausweiskarte. Es wird nur ein Teil deines Ausweises zu Erstellung des Digitalen Ausweis benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data from your Digital ID are different from your ID card. Only part of the card data is used to create your Digital ID."
          }
        }
      }
    },
    "pid_issuance.sheet_explain_data.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum werden nur diese Daten des Ausweises hinzugefügt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are only these ID details added?"
          }
        }
      }
    },
    "pid_issuance.sheet_puk_entry.link" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN-Brief mit PUK verloren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost your PIN letter with PUK?"
          }
        }
      }
    },
    "pid_issuance.sheet_puk_entry.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 10-stellige PUK findest du in deinem PIN-Brief. Diesen Brief hast du bei der Ausstellung deines Personalausweises vom Bürgeramt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 10-digit PUK (unlock code) can be found in the PIN letter you received from the Bürgeramt (citizens' office). This letter also contains your transport PIN."
          }
        }
      }
    },
    "pid_issuance.sheet_puk_entry.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du den Brief nicht mehr hast, wende dich an ein Bürgeramt. Dort kannst die Blockierung deiner PIN aufheben und direkt eine neue Karten-PIN festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du den Brief nicht mehr hast, wende dich an ein Bürgeramt. Dort kannst du die Sperre deiner PIN aufheben und eine neue Karten-PIN festlegen."
          }
        }
      }
    },
    "pid_issuance.sheet_puk_entry.sec_button" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde ein Bürgeramt in deiner Nähe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find a citizens' office near you"
          }
        }
      }
    },
