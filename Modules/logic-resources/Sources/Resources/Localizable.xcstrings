      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Sicherheitsgründen lässt er sich nicht durch Gesichtserkennung oder Fingerabdruck ersetzen."
          }
        },
