      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du den PIN-Brief nicht mehr findest oder falls du deine Karten-PIN vergessen hast, musst du leider zum Bürgeramt und dort eine 6-stellige Karten-PIN festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you can no longer find your PIN letter, or if you have forgotten your card PIN, you will need to visit your citizen's office to set a new 6-digit card PIN."
          }
        }
      }
    },
