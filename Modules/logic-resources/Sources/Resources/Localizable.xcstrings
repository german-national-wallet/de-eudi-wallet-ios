    "eaa_presentation.retry_counter.blocked_paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wichtig: Deine Wallet ist gesperrt. Du kannst eine neue Wallet-PIN festlegen, indem du deinen Digitalen Ausweis löschst und danach wieder hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important: Your wallet is locked. You can set a new Wallet PIN by deleting your digital ID and adding it again."
          }
        }
      }
    },
    "eaa_presentation.retry_counter.counter_overlay_paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte prüfe zuerst, ob deine Wallet-PIN in einem Passwort-Manager gespeichert ist. Falls du sie nicht mehr weißt, kannst du deinen Digitalen Ausweis löschen und neu hinzufügen. Dabei legst du eine neue Wallet-PIN fest. Deine Aktivitätsdaten bleiben erhalten, bis du den neuen Digitalen Ausweis hinzugefügt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First, check if your Wallet PIN is saved in a password manager. If you don’t remember it, you can delete your Digital ID and add it again. You’ll then set a new Wallet PIN. Your activity data stays saved until you add the new Digital ID."
          }
        }
      }
    },
