      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube die Nutzung deiner Kamera, um QR-Codes zu scannen. Das ermöglicht dir dich einfach über Geräte hinweg oder vor Ort auszuweisen und neue Nachweise hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow the use of your camera to scan QR codes. This lets you easily identify yourself via devices or on-site, and add new credentials."
          }
        }
      }
