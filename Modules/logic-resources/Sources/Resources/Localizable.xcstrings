          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is not all data required?"
          }
        }
      }
    },
    "eaa_presentation.sheet_wallet_pin_entry.info_security_pin_button" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist die Wallet-PIN?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is the Wallet-PIN?"
          }
        }
