    "pid_issuance.can_intro.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN pausiert: Gib deine CAN ein, um fortzufahren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important: Your card PIN is paused. Once you have successfully entered the CAN, you can try entering the card PIN one more time. Make sure you’ve already set a 6-digit card PIN."
          }
        }
      }
    },
    "pid_issuance.can_intro.prim_button" : {
      "extractionState" : "manual",
