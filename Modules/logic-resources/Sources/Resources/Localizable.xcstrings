      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzung auf diesem Gerät nicht möglich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use on this device not possible"
          }
        }
      }
    },
    "app_onboarding.device_vulnerable_unfixable.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Gerät wurde eine kritische Sicherheitslücke erkannt. Die App wurde zurückgesetzt und  alle Daten gelöscht.  Installiere App auf einem anderen Gerät und starte die App danach erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A critical security vulnerability was detected on your device. The app has been reset and all data has been deleted. Please install the app on a different device, then restart it."
          }
        }
      }
    },
    "app_onboarding.device_vulnerable_unfixable.title" : {
