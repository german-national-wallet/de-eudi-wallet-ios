        }
      }
    },
    "pid_issuance.card_pin_letter_info.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast sie entweder bei der Abholung im Bürgeramt festgelegt oder mit der 5-stelligen Transport-PIN aus deinem PIN-Brief. Noch nicht festgelegt? Du kannst das hier einmalig nachholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set it either when picking up your ID at the citizens' office, or with the 5-digit transport PIN from your PIN letter. Haven't set it yet? You can do it here, once."
          }
        }
      }
    },
