    "eid_setup.sheet_can_entry.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du findest die Zugangsnummer (CAN) unten rechts auf der Vorderseite deines Ausweises oder Aufenthaltstitels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can find the access number (CAN) on the bottom right of the front of your ID card or residence permit."
          }
        }
      }
    },
    "eid_setup.sheet_can_entry.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo ist die CAN"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is the CAN"
          }
        }
      }
    },
    "eid_setup.sheet_forgot_pin.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du den Einmal-PIN/Transport-PIN vergessen hast bzw. dein PIN-Brief nicht mehr findest, wende dich an dein Bürgeramt. Dort können sie dir direkt eine Karten-PIN einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you lost your letter with the 5-digit one-time PIN/transport PIN, or if you set your 6-digit card PIN but forgot it, you can set a new card PIN at a local Citizens’ Office."
          }
        }
      }
    },
    "eid_setup.sheet_forgot_pin.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal-PIN vergessen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No PIN letter available"
          }
        }
      }
    },
    "eid_setup.sheet_no_letter.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solltest du den Brief mit deiner 5-stellige Transport-PIN nicht mehr haben oder du hast deine 6-stellige Karten-PIN festgelegt, aber wieder vergessen, kannst du bei einem Bürgeramt in deiner Nähe eine neue Karten-PIN festlegen. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you lost your letter with the 5-digit transport PIN, or if you set your 6-digit card PIN but forgot it, you can set a new card PIN at a local Citizens’ Office."
          }
        }
      }
    },
    "eid_setup.sheet_no_letter.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein PIN-Brief vorhanden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No PIN letter available"
          }
        }
      }
    },
    "eid_setup.sheet_pin_letter.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Ausstellung deines Ausweises hast du einen zweiseitigen Brief per Post erhalten. Darin befindet sich eine 5-stellige Einmal-PIN, mit der du hier in der App deine persönliche 6-stellige Karten-PIN für deinen Ausweis festlegen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your ID card was issued, you received a letter by mail containing a 5-digit one-time PIN. Use this PIN to set your personal 6-digit card PIN for your ID card in the app."
          }
        }
      }
    },
    "eid_setup.sheet_pin_letter.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du den Brief nicht mehr hast, wende dich an ein Bürgeramt. Dort können sie dir direkt eine Karten-PIN einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you no longer have the letter, contact a citizen's office. They can help you obtain a new one."
          }
        }
      }
    },
    "eid_setup.sheet_pin_letter.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist der PIN-Brief?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's the PIN letter?"
          }
        }
      }
    },
    "eid_setup.sheet_pin_not_work.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das passiert, wenn du deinen Karten-PIN bereits festgelegt hast, zum Beispiel im Bürgeramt, über eine andere App oder deine Wallet. In dem Fall ist der Einmal-PIN aus deinem PIN-Brief nicht mehr gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like your card PIN was already set up — maybe at a registration office, through another app, or in your Wallet. Because of that, the one-time PIN from your PIN letter won't work anymore."
          }
        }
      }
    },
    "eid_setup.sheet_pin_not_work.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN vergessen? Geh einfach zu deinem Bürgeramt, dort wird dir direkt ein neuer Karten-PIN eingerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your PIN? No worries. Just visit your local Bürgeramt and they'll set up a new card PIN for you on the spot."
          }
        }
      }
    },
    "eid_setup.sheet_pin_not_work.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal-PIN funktioniert nicht?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-Time PIN not working?"
          }
        }
      }
    },
    "eid_setup.sheet_puk_entry.link" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN-Brief mit PUK verloren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost your PIN letter with PUK?"
          }
        }
      }
    },
    "eid_setup.sheet_puk_entry.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 10-stellige PUK (Entsperr-Code) steht im PIN-Brief, den du vom Bürgeramt bekommen hast. In diesem Brief findest du auch deine Transport-PIN"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 10-digit PUK (unlock code) can be found in the PIN letter you received from the Bürgeramt (citizens' office). This letter also contains your transport PIN."
          }
        }
      }
