    "pid_inspection.sheet_pid_personal_data.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die sechs “Alter als XX” Werte deiner Daten sind für die Altersverifzierung hinterlegt. Hiermit erfährt ein Dienst nicht dein genaus Alter sondern nur ob du ein gewisses Alter erreicht hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The six “Over XX” values from your data are stored for age verification. This allows a service to verify whether you meet a required age without revealing your exact age."
          }
        }
      }
    },
