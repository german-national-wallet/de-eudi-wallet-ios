    "app_onboarding.onboarding_2.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der App kannst du viele Dinge im Alltag erledigen: dich ausweisen, ein Konto eröffnen oder dich bei Online-Diensten anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
