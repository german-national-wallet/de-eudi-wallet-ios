    "pid_presentation.dialog_rp_overasking.paragraph_overasking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Dienst fordert mehr Daten an als erlaubt. Aus Sicherheitsgründen wurde die Anfrage automatisch abgelehnt. Bitte kontaktiere den Dienst oder melde ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This service is requesting more data than is permitted. For security reasons, the wallet automatically rejected the request. Please contact or report the service."
          }
        }
      }
    },
