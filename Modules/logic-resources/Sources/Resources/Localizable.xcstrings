      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wallet ist gesperrt. Du kannst einen neuen Digitaler-Ausweis-Code festlegen, indem du deinen Digitalen Ausweis löschst und danach wieder hinzufügst."
