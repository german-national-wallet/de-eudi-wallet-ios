    "app_onboarding.device_vulnerable_fixable.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Gerät wurde eine kritische Sicherheitslücke erkannt. Die App wurde zurückgesetzt und  alle Daten gelöscht. Bitte aktualisiere die App und starte die App danach erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A critical security vulnerability was detected on your device. The app has been reset and all data has been deleted. Please update the app, then restart it."
          }
        }
      }
    },
    "app_onboarding.device_vulnerable_fixable.prim_button" : {
      "extractionState" : "manual",
