          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why is not all data required?"
          }
        }
      }
    },
    "pid_presentation.sheet_wallet_pin_entry.info_security_pin_button" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist der Digitaler-Ausweis-Code?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is the Digital ID code?"
          }
        }
      }
    },
    "pid_presentation.sheet_wallet_pin_entry.paragraph" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine 6-stellige Wallet-PIN hast du festgelegt, als du deinen Personalausweis in die EUDI Wallet DE-App geladen hast. Sie wird abgefragt, wenn die Übertragung besonders geschützter Daten aus Nachweisen, wie des digitalen Ausweises oder Führerscheins, bestätigt werden muss. Aus Sicherheitsgründen kann die PIN nicht durch Fingerabdruck oder Gesichtserkennung ersetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose this 6-digit PIN when you added your ID to the EUDI Wallet DE app. It’s needed to confirm the transfer of highly protected documents, like your digital ID or driver’s license. For security reasons, the PIN cannot be replaced by fingerprint or face recognition."
          }
        }
      }
    },
    "pid_presentation.sheet_wallet_pin_entry.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinen 6-stelligen Digitaler-Ausweis-Code hast du festgelegt, als du deinen Personalausweis in die „App name” geladen hast. Er wird abgefragt, wenn die Übertragung besonders geschützter Daten aus Nachweisen wie dem digitalen Ausweis bestätigt werden muss. Der Code kann nicht durch Fingerabdruck- oder Gesichtserkennung ersetzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set your 6-digit Digital ID code when you added your identity document to “App name”. It is required to confirm the transfer of highly sensitive data, such as information from your digital ID. This code cannot be replaced by fingerprint or face recognition."
          }
        }
      }
    },
    "pid_presentation.sheet_wallet_pin_entry.paragraph_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls du dein Digitaler-Ausweis-Code vergessen hast, musst du deinen Digitalen Ausweis neu hinzufügen. Dabei kannst du einen Wallet-Code festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you forget your Digital ID code, you’ll need to add your Digital ID again. During this process, you can create a new wallet code."
          }
        }
      }
    },
    "pid_presentation.sheet_wallet_pin_entry.prim_button" : {
