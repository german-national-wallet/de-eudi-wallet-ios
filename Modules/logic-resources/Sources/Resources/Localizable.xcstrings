      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merke dir dein Digitaler-Ausweis-Code gut. Du brauchst ihn, wenn du Daten aus deinem digitalen Ausweis mit einem Service (z. B. einer Bank) teilst. "
