    "pid_issuance.card_pin_letter_info.paragraph_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deiner 6-stelligen Karten-PIN nutzt du die Online-Ausweisfunktion, bestätigst deine Identität und erstellst deinen Digitalen Ausweis in dieser Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your 6-digit card PIN lets you use the online ID function, confirm your identity, and create your digital ID in this wallet."
