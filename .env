# PLACEHOLDER -- published by oss-sync/extra/, not the file used to build.
#
# The real .env is git-ignored and never enters the publish set. The app target
# copies this file in as a resource, so the build fails outright without it;
# the KEYS are published so a reader can see which secrets the app expects.
#
# Replace the values with your own to talk to real services. With these
# placeholders the app builds and runs, and every authenticated call fails.
API_KEY=PLACEHOLDER_API_KEY
X_AUTH_API_TOKEN=PLACEHOLDER_X_AUTH_API_TOKEN
FEATURE_FLAG_API_KEY=PLACEHOLDER_FEATURE_FLAG_API_KEY
